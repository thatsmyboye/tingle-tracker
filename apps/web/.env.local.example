# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# New projects use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY; older projects use NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared Pooler URL (IPv4 compatible) for direct DB access / migrations
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Anthropic
ANTHROPIC_API_KEY=

# App origin — used as Referer header in server-side YouTube API calls.
# Required when the YouTube API key has HTTP-referrer restrictions set.
# Production value: https://tingle-tracker.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# YouTube Data API v3
YOUTUBE_DATA_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Audio feature extraction worker (Phase 2)
# Local dev: http://localhost:8000  Production: https://tingle-audio-worker.fly.dev
# Leave blank to skip audio extraction and fall back to transcript-only analysis.
AUDIO_WORKER_URL=
# Shared secret sent as X-Worker-Secret header — must match fly secret AUDIO_WORKER_SECRET
AUDIO_WORKER_SECRET=
