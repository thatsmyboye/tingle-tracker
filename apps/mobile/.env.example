# Supabase (use EXPO_PUBLIC_ prefix for client-accessible vars)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# New Supabase projects: use PUBLISHABLE_DEFAULT_KEY (replaces ANON_KEY)
# Run `supabase status` to get the value — it is labelled "anon key".
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Older Supabase projects still use ANON_KEY — set whichever applies:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Next.js web API base URL (for AI/Inngest-triggered operations)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
